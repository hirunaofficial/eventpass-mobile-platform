generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  attendee
  staff
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           UserRole        @default(attendee)
  createdAt      DateTime        @default(now())
  tickets        Ticket[]
  itineraryItems ItineraryItem[]
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  address String
  lat     Float
  lng     Float
  events  Event[]
}

model Event {
  id             String          @id @default(cuid())
  title          String
  description    String
  venue          Venue           @relation(fields: [venueId], references: [id])
  venueId        String
  startsAt       DateTime
  endsAt         DateTime
  capacity       Int
  remaining      Int
  // A key into the app's own bundled category illustrations (e.g.
  // "tech", "music")- not a remote URL. All event artwork is
  // self-authored (see app/src/assets/event-categories/), never a
  // third-party/stock image.
  imageKey       String?
  tickets        Ticket[]
  itineraryItems ItineraryItem[]
}

enum TicketStatus {
  reserved
  confirmed
  cancelled
}

model Ticket {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  event       Event        @relation(fields: [eventId], references: [id])
  eventId     String
  status      TicketStatus
  qrToken     String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  checkedInAt DateTime?
}

model ItineraryItem {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  event   Event    @relation(fields: [eventId], references: [id])
  eventId String
  addedAt DateTime @default(now())

  @@unique([userId, eventId])
}
