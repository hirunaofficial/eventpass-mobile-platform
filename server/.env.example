# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored; this template is committed. Never put a real
# secret in this file.

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
# Must match the POSTGRES_* values below, including the host port.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE?schema=public"

# Signs session JWTs. Use a long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------
# Docker Compose (read by docker-compose.yml)
# ---------------------------------------------------------------------
# Postgres reads these only when the `eventpass_pgdata` volume is first
# created. Changing them afterwards has no effect unless the volume is
# recreated (`docker compose down -v`), which erases all local data.
POSTGRES_USER=eventpass
POSTGRES_PASSWORD=replace-me-with-a-strong-random-string
POSTGRES_DB=eventpass

# Host-side port. 5433 by default because 5432 is often already taken.
POSTGRES_HOST_PORT=5433

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-me
PGADMIN_HOST_PORT=5050

# ---------------------------------------------------------------------
# Seeded demo accounts (read by prisma/seed.ts).
# If unset, seed.ts falls back to built-in defaults so a fresh clone runs
# without configuration. Set these to override.
# ---------------------------------------------------------------------
STAFF_PASSWORD=replace-me
DEMO_PASSWORD=replace-me
