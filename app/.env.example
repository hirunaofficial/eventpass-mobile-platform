# Copy to `.env` only if you need to override the API host.
#
# Normally you do NOT need this file. With EXPO_PUBLIC_API_URL unset,
# the app derives the API host from Expo's own `hostUri` - the address
# it was served from - so it works on any network without configuration.
#
# Set it only to point at a non-local backend. Note that EXPO_PUBLIC_*
# values are inlined at BUILD time, so changing this needs a Metro
# restart, not just a reload.
#
# EXPO_PUBLIC_API_URL=https://api.example.com
